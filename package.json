{
  "name": "arab-power-twin",
  "productName": "Arab Power Twin",
  "version": "1.0.0",
  "description": "Educational digital-twin simulator of real power plants across the Arab world (التوأم الرقمي لمحطات الطاقة في الوطن العربي)",
  "main": "src/main/main.js",
  "author": {
    "name": "Asfan Trading",
    "email": "asfantrading@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/asfantrading-create/power-plant-for-the-arab-world",
  "repository": {
    "type": "git",
    "url": "https://github.com/asfantrading-create/power-plant-for-the-arab-world.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "node scripts/build-renderer.mjs --watch",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:data": "node scripts/build-dataset.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/check-syntax.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist:win": "npm run build:renderer && electron-builder --win --x64 --publish never",
    "release:win": "npm run build:renderer && electron-builder --win --x64 --publish always",
    "license": "node tools/license-cli/index.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "chart.js": "^4.5.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.0"
  }
}
